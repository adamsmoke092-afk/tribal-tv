<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for playlist fetch (PlaylistRepository) and stream playback (ExoPlayer). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background play (PlaybackService, a media3 MediaSessionService):
         FOREGROUND_SERVICE + its mediaPlayback type let the service run while
         posting the media notification; WAKE_LOCK backs the player's network
         wake mode (screen-off streaming); POST_NOTIFICATIONS is a runtime
         permission on 13+ — without it Android hides the notification but
         playback keeps running. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.TribalTV"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic="true": public IPTV stream URLs are frequently
          plain HTTP, not HTTPS. Android blocks cleartext HTTP by default
          since API 28 — without this, playlist fetch or playback can fail
          silently with no obvious error (SPEC §4, risk #3). Acceptable for a
          personal-use app; if this is ever distributed, scope down to a
          network_security_config.xml allowlisting only the domains actually
          used, per SPEC §3's legal/positioning note.
        -->

        <!-- supportsPictureInPicture: enterPictureInPictureMode() throws
             IllegalStateException unless the activity declares this. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The media3 session service. SessionToken refuses to bind without
             the MediaSessionService intent-filter action; the
             foregroundServiceType is what lets playback continue in the
             background with the media notification. -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
