<?xml version="1.0" encoding="utf-8"?>
<!-- Retro TV with a play triangle, drawn inside the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Antennas -->
    <path
        android:pathData="M54,30 L42,40 M54,30 L66,40"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- TV body -->
    <path
        android:pathData="M34,40 L74,40 A6,6 0 0 1 80,46 L80,70 A6,6 0 0 1 74,76 L34,76 A6,6 0 0 1 28,70 L28,46 A6,6 0 0 1 34,40 Z"
        android:fillColor="#FFFFFF" />

    <!-- Play triangle, "cut out" in the background color -->
    <path
        android:pathData="M48,48 L64,58 L48,68 Z"
        android:fillColor="@color/ic_launcher_background" />

    <!-- Legs -->
    <path
        android:pathData="M38,80 L38,84 M70,80 L70,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
