<?xml version="1.0" encoding="utf-8"?>
<!-- Retro TV with a play triangle: gold line art on the black icon
     background. Drawn on the full 108dp adaptive canvas, art kept inside
     the 66dp safe zone so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Antennas -->
    <path
        android:strokeColor="#D4AF37"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,36 L44,26 M54,36 L64,26" />
    <!-- TV body -->
    <path
        android:fillColor="#1C1C1E"
        android:strokeColor="#D4AF37"
        android:strokeWidth="3.5"
        android:pathData="M39,36 h30 a9,9 0 0 1 9,9 v18 a9,9 0 0 1 -9,9 h-30 a9,9 0 0 1 -9,-9 v-18 a9,9 0 0 1 9,-9 z" />
    <!-- Play triangle -->
    <path
        android:fillColor="#D4AF37"
        android:strokeColor="#D4AF37"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M49,46 L49,62 L63,54 z" />
    <!-- Stand -->
    <path
        android:strokeColor="#A0A0A6"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M46,79 L62,79" />
</vector>