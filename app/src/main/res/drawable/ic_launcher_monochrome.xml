<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon variant (Android 13+): same art as the foreground but a
     single white tone. The TV body is an outline only (no fill) so the
     system can tint the whole glyph; the play triangle keeps its fill. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Antennas -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,36 L44,26 M54,36 L64,26" />
    <!-- TV body (outline only) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:pathData="M39,36 h30 a9,9 0 0 1 9,9 v18 a9,9 0 0 1 -9,9 h-30 a9,9 0 0 1 -9,-9 v-18 a9,9 0 0 1 9,-9 z" />
    <!-- Play triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M49,46 L49,62 L63,54 z" />
    <!-- Stand -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M46,79 L62,79" />
</vector>