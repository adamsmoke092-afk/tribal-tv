<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch/window theme only — everything on screen is Compose
      (TribalTvTheme). Platform dark base, NOT Theme.Material3.*: that
      parent ships in the Material Components XML library, which this app
      deliberately has no dependency on — using it would fail resource
      linking. Stops a white flash at launch and keeps the bars dark.
    -->
    <style name="Theme.TribalTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Media3 PlayerView reads the platform accent for its scrubber
             and progress bar. -->
        <item name="android:colorAccent">@color/gold_accent</item>
    </style>
</resources>
