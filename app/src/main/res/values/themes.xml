<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch/window theme only — everything on screen is Compose
      (MaterialTheme), so no Material Components XML library is needed.
      This just controls the window surface until the first frame draws
      and keeps status/nav bars from flashing white in the dark app.
    -->
    <style name="Theme.TribalTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
    </style>
</resources>
